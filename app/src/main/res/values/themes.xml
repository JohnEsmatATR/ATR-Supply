<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.ATRAPP" parent="Theme.Material3.Light.NoActionBar">
        <!-- Customize your light theme here. -->
        <item name="colorPrimary">@color/offWhite</item>
        <item name="android:windowLightStatusBar">@color/black</item>
        <item name="colorAccent">@color/orange</item>

    </style>

    <style name="Theme.ATRAPP" parent="Base.Theme.ATRAPP" />

    <style name="circleImageView" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>


    <style name="TextInputLayoutAppearance" parent="Widget.Design.TextInputLayout">
        <item name="colorControlActivated">@color/orange</item>
        <item name="colorAccent">@color/orange</item>
    </style>

    <style name="CustomDatePickerDialog" parent="ThemeOverlay.MaterialComponents.Dialog">
        <item name="colorPrimary">@color/orange</item>
        <item name="colorAccent">@color/orange</item>
    </style>

</resources>