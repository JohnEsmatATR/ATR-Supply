<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="productModel"
            type="com.akhnaton.atrSupply.data.model.ProductModel" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="10dp"
        android:layout_marginVertical="5dp">

        <androidx.cardview.widget.CardView
            android:id="@+id/card_image"
            android:layout_width="150dp"
            android:layout_height="wrap_content"
            app:cardCornerRadius="15dp"
            app:cardElevation="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp">

                <ImageView
                    android:id="@+id/im_item"
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:scaleType="fitXY"
                    tools:src="@drawable/im_category"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    />

                <ImageView
                    android:id="@+id/im_favorite"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:adjustViewBounds="true"
                    android:scaleType="fitXY"
                    android:alpha="0.9"
                    android:layout_marginEnd="@dimen/_5ssp"
                    android:layout_marginTop="@dimen/_5ssp"
                    android:src="@drawable/ic_favorite_fill"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <ImageView
                    android:id="@+id/im_discount"
                    android:layout_width="30dp"
                    android:layout_height="12dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_best_seller"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/txt_percentage"
                    android:layout_width="30dp"
                    android:layout_height="12dp"
                    android:layout_marginStart="10dp"
                    android:textColor="@color/white"
                    android:textSize="10sp"
                    android:text="@{productModel.PRICE_DISCOUNT_PERCENTAGE}"
                    app:layout_constraintBottom_toBottomOf="@id/im_discount"
                    app:layout_constraintEnd_toEndOf="@id/im_discount"
                    app:layout_constraintStart_toStartOf="@id/im_discount"
                    app:layout_constraintTop_toTopOf="@id/im_discount" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/txt_item_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="10dp"
            android:layout_marginTop="10dp"
            android:gravity="start"
            android:textColor="@color/dark_gray"
            android:textSize="12sp"
            android:textStyle="bold"
            android:text="@{productModel.TITLE}"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/card_image"
            tools:text="Body deodorant powder" />

        <TextView
            android:id="@+id/txt_category"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="10dp"
            android:layout_marginTop="5dp"
            android:gravity="start"
            android:textColor="@color/mid_gray_1"
            android:textSize="10sp"
            android:text="@{productModel.category != null &amp;&amp; productModel.category.TITLE != null ? productModel.category.TITLE : ``}"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/txt_item_name"
            tools:text="Category Name" />

        <LinearLayout
            android:id="@+id/linearLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="10dp"
            android:layout_marginTop="@dimen/_5sdp"
            android:gravity="start"
            android:orientation="horizontal"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/txt_category">

            <TextView
                android:id="@+id/txt_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="1dp"
                android:gravity="start"
                android:text="@{productModel.PRICE_AFTER_DISCOUNT + ` LE`}"
                android:textColor="@color/dark_gray"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txt_old_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="1dp"
                android:gravity="center"
                android:text="@{productModel.PRICE_WITH_TAX + ` LE`}"
                android:textColor="@color/mid_gray_1"
                android:textSize="10sp"
                android:visibility="gone"
                tools:text="44.00 EGP" />

        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_add_to_cart"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_margin="10dp"
            android:background="@drawable/btn_orange_style"
            android:foreground="?android:attr/selectableItemBackground"
            android:text="@string/add_to_cart"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:padding="0dp"
            app:backgroundTint="@null"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/linearLayout" />

        <ImageView
            android:id="@+id/imageView"
            android:layout_width="@dimen/_20sdp"
            android:layout_height="@dimen/_20sdp"
            android:src="@drawable/gift"
            app:layout_constraintBottom_toBottomOf="@+id/linearLayout"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginEnd="@dimen/_5sdp"
            app:layout_constraintTop_toTopOf="@+id/linearLayout" />

        <RatingBar
            android:id="@+id/rating_bar"
            style="?android:attr/ratingBarStyleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="10dp"
            android:gravity="start"
            android:numStars="5"
            android:visibility="gone"
            android:progressBackgroundTint="@color/gray"
            android:progressTint="@color/quantum_yellow"
            android:rating="4"
            android:scaleX="1"
            android:scaleY="1"
            android:secondaryProgressTint="@color/quantum_yellow"
            android:stepSize="0.1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/linearLayout" />

        <TextView
            android:id="@+id/txt_stock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="10dp"
            android:gravity="center"
            android:text="@{`(` + productModel.PRICE_DISCOUNT_PERCENTAGE + ` off)`}"
            android:textColor="@color/teal"
            android:textSize="12sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/rating_bar"
            />

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>
