<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tootls="http://schemas.android.com/tools">

    <data>

        <variable
            name="data"
            type="com.akhnaton.atrapp.data.model.orderHistory.OrderDetailsModel" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/_100sdp"

        android:layout_margin="@dimen/_10sdp"
        android:background="@color/lightGray">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardImg"
            android:layout_width="@dimen/_80sdp"
            android:layout_height="@dimen/_80sdp"
            android:layout_marginStart="@dimen/_12sdp"
            app:cardBackgroundColor="@color/white"
            app:cardElevation="@dimen/_2sdp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:strokeColor="@null"
            app:strokeWidth="0dp">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/_8sdp"
                android:src="@drawable/im_best_seller" />

        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/productName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_12sdp"
            android:layout_marginEnd="@dimen/_26sdp"
            android:fontFamily="sans-serif-medium"
            android:text="@{data.name}"
            android:textSize="@dimen/_12sdp"
            app:layout_constraintBottom_toTopOf="@+id/quantity"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/cardImg"
            app:layout_constraintTop_toTopOf="@+id/cardImg"
            tootls:text="Eva Hand soap royal Deep Lines Filler 50 ML" />

        <TextView
            android:id="@+id/quantity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_12sdp"
            android:layout_marginTop="@dimen/_4sdp"
            android:text="@{`Quantity: ` + data.quantity}"
            android:textColor="@color/black"
            tootls:text="Quantity: 4"
            app:layout_constraintBottom_toTopOf="@+id/priceLayout"
            app:layout_constraintStart_toEndOf="@+id/cardImg"
            app:layout_constraintTop_toBottomOf="@id/productName" />

        <LinearLayout
            android:id="@+id/priceLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_12sdp"
            android:layout_marginTop="@dimen/_4sdp"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="@+id/cardImg"
            app:layout_constraintStart_toEndOf="@+id/cardImg"
            app:layout_constraintTop_toBottomOf="@id/quantity">

            <TextView
                android:id="@+id/priceTxt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Price:"
                android:textColor="@color/black" />

            <TextView
                android:id="@+id/price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_4sdp"
                android:text="@{data.price +` EGP`}"
                tootls:text="345 EGP"
                android:textColor="@color/black" />

            <TextView
                android:id="@+id/discountPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_4sdp"
                android:text="@{data.discountPrice +` EGP`}"
                tootls:text="345 EGP"
                android:textColor="@color/black" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>