<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="data"
            type="com.akhnaton.atrapp.data.model.orderHistory.Item" />
    </data>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="0dp"
        android:layout_marginBottom="12dp"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/divider_gray"
        app:strokeWidth="1dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardImg"
                android:layout_width="60dp"
                android:layout_height="60dp"
                app:cardBackgroundColor="@color/bg_light_gray"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:id="@+id/imgProduct"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_margin="8dp"
                    android:scaleType="fitCenter"
                    tools:src="@drawable/im_category" />

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/productName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:text='@{String.valueOf(data.TITLE)}'
                android:textColor="@color/black"
                android:textSize="14sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/cardImg"
                app:layout_constraintTop_toTopOf="@+id/cardImg"
                tools:text="Betmiga 50 mg Prolonged Release Tablets" />

            <LinearLayout
                android:id="@+id/leftValuesContainer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="@+id/productName"
                app:layout_constraintTop_toBottomOf="@+id/productName">

                <LinearLayout
                    android:id="@+id/qtyContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:background="@color/order_item_quantity_background"
                    android:orientation="vertical"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="5dp">

                    <TextView
                        android:id="@+id/textView2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/qty_label"
                        android:textColor="@color/order_number_gray"
                        android:textSize="9sp"
                        tools:text="Qty: " />

                    <TextView
                        android:id="@+id/quantity"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@{String.valueOf(data.QUANTITY)}"
                        android:textColor="@color/black"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        tools:text="11" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:background="@color/order_item_quantity_background"
                    android:orientation="vertical"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="5dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/price_without_tax_product_det"
                        android:textColor="@color/order_number_gray"
                        android:textSize="9sp" />

                    <TextView
                        android:id="@+id/unitPriceDisplay"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@{String.valueOf(data.UNIT_PRICE_WITHOUT_TAX + ``) + ` ` + @string/currency}"
                        android:textColor="@color/black"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        tools:text="135 EGP" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:background="@color/order_item_quantity_background"
                    android:orientation="vertical"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="5dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/order_item_price_with_tax"
                        android:textColor="@color/order_number_gray"
                        android:textSize="9sp" />

                    <TextView
                        android:id="@+id/unitPriceWithTax"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@{String.valueOf(data.UNIT_PRICE_WITH_TAX + ``) + ` ` + @string/currency}"
                        android:textColor="@color/black"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        tools:text="135 EGP" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@color/order_item_quantity_background"
                    android:orientation="vertical"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="5dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/tax"
                        android:textColor="#E8750A"
                        android:textSize="9sp" />

                    <TextView
                        android:id="@+id/taxValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@{String.valueOf(data.TAX_VALUE + ``) + ` ` + @string/currency}"
                        android:textColor="#E8750A"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        tools:text="0 EGP" />
                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/priceLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="@+id/productName"
                app:layout_constraintTop_toBottomOf="@+id/leftValuesContainer">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/order_item_total_without_tax"
                        android:textColor="@color/order_number_gray"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@{String.valueOf(data.TOTAL_UNIT_PRICE_WITHOUT_TAX + ``) + ` ` + @string/currency}"
                        android:textColor="@color/black"
                        android:textSize="12sp"
                        tools:text="1485 EGP" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/order_item_total_with_tax"
                        android:textColor="@color/black"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@{String.valueOf(data.TOTAL_UNIT_PRICE_WITH_TAX + ``) + ` ` + @string/currency}"
                        android:textColor="@color/black"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        tools:text="1485 EGP" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/order_item_total_tax"
                        android:textColor="#E8750A"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@{String.valueOf(data.TOTAL_TAX + ``) + ` ` + @string/currency}"
                        android:textColor="#E8750A"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        tools:text="0 EGP" />
                </LinearLayout>

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>
</layout>